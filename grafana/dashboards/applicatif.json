{
  "title": "Microservice RED",
  "uid": "applicatif",
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Rate — Requetes par seconde",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{
        "expr": "rate(http_requests_total[5m])",
        "legendFormat": "{{endpoint}} {{status_code}}"
      }],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "title": "Errors — Taux d erreur par seconde",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "rate(http_errors_total[5m])",
        "legendFormat": "{{endpoint}}"
      }],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "title": "Duration — Latence p95 (secondes)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 {{endpoint}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "Total requetes par endpoint",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{
        "expr": "sum by(endpoint) (http_requests_total)",
        "legendFormat": "{{endpoint}}"
      }]
    },
    {
      "title": "Latence moyenne par endpoint",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "targets": [{
        "expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])",
        "legendFormat": "{{endpoint}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
