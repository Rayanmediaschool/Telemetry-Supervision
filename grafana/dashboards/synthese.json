{
  "title": "Synthese Multi-Domaines",
  "uid": "synthese",
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "CPU Hote",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{
        "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "CPU %"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        }
      }
    },
    {
      "title": "RAM Hote",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "legendFormat": "RAM %"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        }
      }
    },
    {
      "title": "Temperature moyenne capteurs IoT",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{
        "expr": "avg(mqtt_consumer_temperature)",
        "legendFormat": "Temp moy °C"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 25},
              {"color": "red", "value": 30}
            ]
          }
        }
      }
    },
    {
      "title": "Taux erreur microservice",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{
        "expr": "rate(http_errors_total[5m])",
        "legendFormat": "Erreurs/s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.1}
            ]
          }
        }
      }
    },
    {
      "title": "Vue globale infrastructure",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        },
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM %"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "title": "Vue globale IoT",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "targets": [
        {
          "expr": "avg(mqtt_consumer_temperature)",
          "legendFormat": "Temp moy °C"
        },
        {
          "expr": "avg(mqtt_consumer_batterie)",
          "legendFormat": "Batterie moy %"
        }
      ]
    }
  ]
}
